{
  "multipart": [
    {
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_side_alt"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_noside"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_noside_alt"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "krolasyonfutbol:block/goal_net_noside",
        "y": 270
      }
    }
  ]
}