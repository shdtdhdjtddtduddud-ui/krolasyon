 "gui.krolasyonbosses.alliance_hint": "An alliance requires 50 standing.",
 "gui.krolasyonbosses.blessings": "Blessings",
 "dialog.krolasyonbosses.ash.0": "May ash choke you, stranger. King Varkhas awaits you - at the tip of his sword.",
 "dialog.krolasyonbosses.ash.1": "Child of fire? Prove your honour, then we talk.",
 "dialog.krolasyonbosses.ash.2": "Our forges are open to you, Fireborn. Varkhas speaks of you.",
 "dialog.krolasyonbosses.ash.3": "Brother in fire! The blades of the Ash Kingdom are yours.",
 "dialog.krolasyonbosses.blood.0": "Your blood smells sweet... come no closer, or the queen will drink you.",
 "dialog.krolasyonbosses.blood.1": "Queen Serathis is curious. Curiosity is dangerous, darling.",
 "dialog.krolasyonbosses.blood.2": "The palace doors are ajar for you. A glass of wine... or blood?",
 "dialog.krolasyonbosses.blood.3": "You are one of the Dynasty now. Your enemies will be our feast.",
 "dialog.krolasyonbosses.shadow.0": "The shadows know your name, and they do not want you.",
 "dialog.krolasyonbosses.shadow.1": "The Council sees all. Nyx'ar is watching you... still.",
 "dialog.krolasyonbosses.shadow.2": "Our whispers are now your whispers. Use them carefully.",
 "dialog.krolasyonbosses.shadow.3": "The Council has opened its secrets to you. Betray us and... we will know.",
 "dialog.krolasyonbosses.legion.0": "HALT! Strangers die on Legion soil.",
 "dialog.krolasyonbosses.legion.1": "You look strong. Grommak loves the strong - or crushes them.",
 "dialog.krolasyonbosses.legion.2": "The war drums beat for you, soldier.",
 "dialog.krolasyonbosses.legion.3": "LEGION! The Fireborn marches with us!",
 "dialog.krolasyonbosses.soul.0": "The dead curse your name.",
 "dialog.krolasyonbosses.soul.1": "The souls are undecided. The Oracle Ilvaine has not yet spoken.",
 "dialog.krolasyonbosses.soul.2": "The souls accept you. May your path be lit.",
 "dialog.krolasyonbosses.soul.3": "As keepers of the dead, we bless you, Fireborn.",
 "dialog.krolasyonbosses.tribute_ok": "Your tribute is accepted. (+%s standing)",
 "dialog.krolasyonbosses.tribute_bad": "Is this an insult? Bring us gold, diamonds or the essence of our enemies.",
 "dialog.krolasyonbosses.quest_given": "%s is our enemy. Slay 8 of their soldiers.",
 "dialog.krolasyonbosses.quest_reward": "You have completed the task. Our kingdom will not forget. (+15 standing)",
 "dialog.krolasyonbosses.alliance_ok": "The oath is sworn! Our Sigil is yours now. You do not walk this path alone.",
 "dialog.krolasyonbosses.alliance_no": "We do not trust you yet.",
 "dialog.krolasyonbosses.alliance_soul": "The Cult swears no oaths... but for you we will make an exception.",
 "dialog.krolasyonbosses.already": "We are already kin.",
 "dialog.krolasyonbosses.conquered": "You defeated our lord. Our kingdom bows to you.",
 "dialog.krolasyonbosses.ruler": "My sovereign! Your word is our law.",
