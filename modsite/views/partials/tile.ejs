<a class="tile" href="/mod/<%= p.slug %>">
  <img class="ic" src="<%= p.icon || '/static/img/logo.svg' %>" alt="" loading="lazy">
  <h3><%= p.name %></h3>
  <div class="small muted"><%= u.formatNumber(p.downloads) %> <%= t('common.downloads') %> · <%= p.owner %></div>
  <p style="clear:both;margin-top:10px"><%= p.summary %></p>
</a>
